@model Event_Management.ViewModels.UserTicketsViewModel

@{
    ViewData["Title"] = Model.User?.Name ?? "All Event";
    ViewData["Role"] = Model.User?.Role ?? "User";
    Layout = "~/Views/Shared/User.cshtml";
    var org = Model.User;
    var searchValue = ViewData["SearchQuery"] as string;
    var selectedStatus = ViewData["StatusFilter"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/event.css" />
}

<section>

    <div class="filters">
        <form method="get" asp-controller="User" asp-action="UserEvent" class="search-form">

                @* Event Name Search *@
                <input type="text" name="eventName" placeholder="Search by Event name..." value="@searchValue" />

                @* Status Dropdown *@
                <select name="status" class="status-dropdown">
                    <option value="">Status</option>

                    @if (selectedStatus == "Upcoming")
                    {
                        <option value="Upcoming" selected>Upcoming</option>
                    }
                    else
                    {
                        <option value="Upcoming">Upcoming</option>
                    }

                    @if (selectedStatus == "Completed")
                    {
                        <option value="Completed" selected>Completed</option>
                    }
                    else
                    {
                        <option value="Completed">Completed</option>
                    }
                </select>

                <div class="buttons">
                    @* submit *@
                    <button type="submit" class="submit">
                        <img src="@Url.Content("~/images/Search.svg")" alt="Search" />
                        Search
                    </button>

                    @* reset *@
                    <a asp-controller="User" asp-action="UserEvent" class="reset">
                        <img src="@Url.Content("~/images/Reset.svg")" alt="Search" />
                        Reset
                    </a>
                </div>

        </form>
    </div>

    <div class="orgData">
        @if (Model.Tickets != null && Model.Tickets.Any())
        {
            <p class="totalTic">You have booked <strong>@Model.Tickets.Count</strong> ticket@(Model.Tickets.Count == 1 ? "" : "s").</p>
            foreach (var item in Model.Tickets)
            {
                <a class="step3" asp-controller="Ticket" asp-action="Event" asp-route-id="@item.Event.Id">
                    <div class="banner">
                        <img src="@item.Event.Banner" alt="@item.Event.Name" />
                    </div>
                    <div class="data">
                        <h1>
                            @item.Event.Name
                            | @((item.Event.User != null) ? item.Event.User.Name : "Organizer Unknown")
                        </h1>

                        <div>
                            @(
                                                item?.Event?.DateTime.HasValue == true
                                                ? item.Event.DateTime.Value.ToString("ddd, dd MMM | h tt") + " onwards"
                                                : "-"
                                                )
                        </div>
                        <p>
                            @if (item.Event.Venue == "Online")
                            {
                                <span>Online</span>
                            }
                            else
                            {
                                <span>
                                    @((item?.Event?.VenueName ?? "-")), @((item?.Event?.Address ?? "-"))
                                </span>
                            }
                        </p>
                        <p class="typee">
                            <span class="typeeee">@item.Type</span> - @item.Quantity @((item.Quantity == 1) ? "Ticket" : "Tickets")
                        </p>
                        <p class="tickett">
                            TICKET ID : @item.Id
                        </p>
                        <div>
                            <p>Total Amount : ₹ @item.TotalPrice</p>
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="no-tickets">
                <p>You have no tickets booked!!!</p>
            </div>
        }
    </div>

    

</section>
