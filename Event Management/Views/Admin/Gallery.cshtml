@model Event_Management.Models.Gallery

@{
    ViewData["Title"] = "Gallery";
    Layout = "~/Views/Shared/Admin.cshtml";
    var searchValue = ViewData["NameQuery"] as string;
    var selectedType = ViewData["TypeFilter"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" />
}

<section>

    @* Form *@
    <form asp-action="Gallery" asp-controller="Admin" method="post" enctype="multipart/form-data" class="form-container">
        <div class="formm">
            <input asp-for="Id" type="hidden" />
            <div>
                <p class="img-title">Image</p>
                @if (string.IsNullOrEmpty(Model?.Banner))
                {
                    <input asp-for="BannerFile" type="file" id="ImageFile" accept="image/*" class="file-input" />
                }
                else
                {
                    <label for="ImageFile">
                        <div class="image-cont">
                            <img id="previewImage"
                                 src="@Model.Banner"
                                 alt="Image"
                                 class="data-img" />
                        </div>
                    </label>
                    <input asp-for="BannerFile" type="file" id="ImageFile" accept="image/*" style="display: none;" />

                    <input type="hidden" asp-for="Banner" />
                }

            </div>

            <div class="form-group">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="danger"></span>
            </div>

            <div class="form-group">
            <label asp-for="Type">Event Type</label>
            <select asp-for="Type" class="form-control">
                <option value="">--Select--</option>
                <option value="Organizer">Organizer</option>
                <option value="Paid">Paid</option>
                <option value="Free">Free</option>
            </select>
            <span asp-validation-for="Type" class="danger"></span>
        </div>

            <div class="form-group">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" class="form-control auto-resize"></textarea>
                <span asp-validation-for="Description" class="danger"></span>
            </div>
        </div>

        <div class="sub-button">
            <button type="submit" class="submit">
                @(Model.Id != Guid.Empty ? "Update" : "Add")
            </button>
        </div>
    </form>


    @* Table *@
    <div class="table-container">

        <div class="filters">

            <form method="get" asp-controller="Admin" asp-action="Gallery" class="search-form1" enctype="multipart/form-data">

                @* Event Name Search *@
                <input type="text" name="name" placeholder="Search by Event name..." value="@searchValue" />

                @* Type Filter *@
                <select name="type" class="form-control">
                    <option value="">-- Event Types --</option>

                    @if (selectedType == "Organizer")
                    {
                        <option value="Organizer" selected>Organizer</option>
                    }
                    else
                    {
                        <option value="Organizer">Organizer</option>
                    }

                    @if (selectedType == "Paid")
                    {
                        <option value="Paid" selected>Paid</option>
                    }
                    else
                    {
                        <option value="Paid">Paid</option>
                    }

                    @if (selectedType == "Free")
                    {
                        <option value="Free" selected>Free</option>
                    }
                    else
                    {
                        <option value="Free">Free</option>
                    }
                </select>

                <div class="buttons1">
                    @* submit *@
                    <button type="submit" class="submit">
                        <img src="@Url.Content("~/images/Search.svg")" alt="Search" />
                        Search
                    </button>

                    @* reset *@
                    <a asp-controller="Admin" asp-action="Gallery" class="reset">
                        <img src="@Url.Content("~/images/Reset.svg")" alt="Search" />
                        Reset
                    </a>
                </div>

            </form>
        </div>

        <div class="tabless">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var galleryList = (List<Event_Management.Models.Gallery>)ViewBag.GalleryList;
                    }

                    @if (galleryList.Any())
                    {
                        var index = 1;
                        foreach (var gallery in galleryList)
                        {
                            <tr>
                                <td>@index</td>
                                <td>
                                    <img src="@gallery.Banner" alt="@gallery.Name" class="data-image" />
                                </td>
                                <td>@gallery.Name</td>
                                <td class="description">@gallery.Description</td>
                                <td>@gallery.Type</td>
                                <td>
                                    <a asp-action="Gallery" asp-controller="Admin" asp-route-id="@gallery.Id">
                                        <img src="@Url.Content("~/images/Edit.svg")" alt="Edit" class="action-image" />
                                    </a>
                                    <form asp-action="DeleteGallery" asp-controller="Admin" asp-route-id="@gallery.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this gallery?');">
                                        <button type="submit" style="border:none; background:none; padding:0; cursor:pointer;">
                                            <img src="@Url.Content("~/images/Delete.svg")" alt="Delete" class="action-image" />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="no-data">
                                No gallery entries found.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $('#ImageFile').on('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#previewImage').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            $('.auto-resize').on('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });
        });
    </script>
}
