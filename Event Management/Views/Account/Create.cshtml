@model Eventpro.Domain.Models.Users

@{
    ViewData["Title"] = "Organization | Profile setup";
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/create.css" />
}

<form asp-action="Create" asp-controller="Account" method="post" class="form-container">
    @Html.AntiForgeryToken()

    <div class="heading">Organizer Profile</div>
    <div class="subheading">Your organizer identity starts from here</div>
    <div class="switch-profile">
        Want to attend events instead? <a asp-controller="Account" asp-action="Signup" class="link">Sign up as a User</a>
    </div>

    <div class="form-grid">
        <div class="form-group">
            <label asp-for="Name">Organizer Name/Company</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Person">Contact Person</label>
            <input asp-for="Person" class="form-control" />
            <span asp-validation-for="Person" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Address">Address</label>
            <textarea asp-for="Address" class="form-control"></textarea>
            <span asp-validation-for="Address" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNo">Phone Number</label>
            <input asp-for="PhoneNo" class="form-control" />
            <span asp-validation-for="PhoneNo" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CPassword">Confirm Password</label>
            <input asp-for="CPassword" class="form-control" />
            <span asp-validation-for="CPassword" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Website">Company / Brand Website (if any)</label>
            <input asp-for="Website" class="form-control" />
            <span asp-validation-for="Website" class="danger"></span>
        </div>
    </div>

    <div class="btnn">
        <button type="submit">Create</button>
        <div>
            Already have an Organizer Account ?
            <span>
                <a asp-controller="Account" asp-action="Login" class="create">Login</a>
            </span>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
