@model Event_Management.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Organization Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/form.css" />
}

<form asp-action="Login" asp-controller="Account" method="post" class="form-container">
    @Html.AntiForgeryToken()

    <div class="heading">Login</div>
    <div class="subheading">Welcome back! Please sign in as Organizer</div>

    <div class="form-grid">
        @Html.ValidationSummary(true, "", new { @class = "danger" })
        @* False - Show all errors — both general errors and field-specific errors (like email, password) *@
        @* True - Only show general errors — like "Login failed" or "Something went wrong." *@

        <div class="form-group">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="danger"></span>
        </div>

    </div>

    <div class="btnn">
        <button type="submit">Login</button>
        <div>
            Don't have an Organizer Account ?
            <span>
                <a asp-controller="Account" asp-action="Create" class="create">Create</a>
            </span>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
